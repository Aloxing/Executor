{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "executor",
  "version": "0.1.0",
  "identifier": "com.aloxing.executor",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Executor",
        "width": 1600,
        "height": 960,
        "minWidth": 880,
        "minHeight": 560,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "dragDropEnabled": true,
        "browserExtensionsEnabled": false,
        "generalAutofillEnabled": false,
        "zoomHotkeysEnabled": false,
        "devtools": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,AutofillServerCommunication,WinUseBrowserSpellChecker,msWebView2EnableTrackingPrevention,msWebView2EnableShoppingFeatures,msWebView2EnableFamilySafety --disable-extensions --disable-background-networking --disable-component-update --disable-sync --disable-breakpad --no-first-run --disable-gpu"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
